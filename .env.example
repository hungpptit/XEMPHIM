# =================================================================
# XEMPHIM Microservices Ecosystem - Environment Configuration Template
# Copy this file to .env and adjust credentials accordingly.
# DO NOT commit the .env file containing real secrets to version control.
# =================================================================

# Database Connection (Physical / Logical Instance)
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASS=YourStrongPasswordHere

# Individual Microservices Databases
USER_DB_NAME=XemPhim_User
MOVIE_DB_NAME=XemPhim_Movie
SEAT_DB_NAME=XemPhim_Seat
BOOKING_DB_NAME=XemPhim_Booking
PAYMENT_DB_NAME=XemPhim_Payment

# Distributed Infrastructure
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-change-in-production

# ZaloPay Sandbox / Production Credentials
ZALOPAY_APP_ID=2554
ZALOPAY_KEY1=your_zalopay_key1
ZALOPAY_KEY2=your_zalopay_key2
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn

# Notification Service (Gmail SMTP / App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
